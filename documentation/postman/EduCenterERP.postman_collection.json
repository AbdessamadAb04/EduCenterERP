{
  "info": {
    "name": "EduCenterERP - Jalon 02",
    "description": "Eureka discovery, discovery-based gateway smoke and write checks for the Jalon 02 services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "eurekaUrl", "value": "http://localhost:8761" },
    { "key": "etablissementId", "value": "1" },
    { "key": "classeId", "value": "1" },
    { "key": "studentId", "value": "1" },
    { "key": "paymentId", "value": "1" },
    { "key": "email", "value": "demo@educenter.local" }
  ],
  "item": [
    {
      "name": "Discovery",
      "item": [
        {
          "name": "Eureka applications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{eurekaUrl}}/eureka/apps"
          }
        },
        {
          "name": "Gateway actuator health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health"
          }
        },
        {
          "name": "Gateway actuator routes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/gateway/routes"
          }
        }
      ]
    },
    {
      "name": "Smoke",
      "item": [
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me?email={{email}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"],
              "query": [{ "key": "email", "value": "{{email}}" }]
            }
          }
        },
        {
          "name": "List etablissements",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/etablissements"
          }
        },
        {
          "name": "List classes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes?etablissement_id={{etablissementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"],
              "query": [{ "key": "etablissement_id", "value": "{{etablissementId}}" }]
            }
          }
        },
        {
          "name": "List students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students?etablissement_id={{etablissementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"],
              "query": [{ "key": "etablissement_id", "value": "{{etablissementId}}" }]
            }
          }
        },
        {
          "name": "List sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions?etablissement_id={{etablissementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions"],
              "query": [{ "key": "etablissement_id", "value": "{{etablissementId}}" }]
            }
          }
        },
        {
          "name": "List payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments?etablissement_id={{etablissementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments"],
              "query": [{ "key": "etablissement_id", "value": "{{etablissementId}}" }]
            }
          }
        },
        {
          "name": "Count payments for student",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/count?student_id={{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "count"],
              "query": [{ "key": "student_id", "value": "{{studentId}}" }]
            }
          }
        },
        {
          "name": "Get dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/dashboard"
          }
        },
        {
          "name": "Download receipt",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payments/{{paymentId}}/receipt"
          }
        }
      ]
    },
    {
      "name": "Writes",
      "item": [
        {
          "name": "Create class",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Espagnol - A1\",\n  \"subject\": \"Espagnol\",\n  \"level\": \"A1\",\n  \"teacher\": \"Sofia Amrani\",\n  \"max_capacity\": 12,\n  \"tarif_amount\": 450,\n  \"tarif_period\": \"mensuel\",\n  \"color\": \"#F59E0B\",\n  \"etablissement_id\": \"{{etablissementId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/classes"
          }
        },
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Nadia Idrissi\",\n  \"phone\": \"0669998888\",\n  \"classe_id\": \"{{classeId}}\",\n  \"enrollment_date\": \"2026-11-22\",\n  \"tuition_fee\": 500,\n  \"registration_fee\": 200\n}"
            },
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "Create payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": \"{{studentId}}\",\n  \"amount\": 500,\n  \"due_date\": \"2026-12-22\",\n  \"method\": \"Virement\",\n  \"payment_category\": \"TUITION\"\n}"
            },
            "url": "{{baseUrl}}/api/payments"
          }
        },
        {
          "name": "Delete student with payments (expect 400)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        }
      ]
    }
  ]
}
